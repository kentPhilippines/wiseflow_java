# 服务器运行配置。修改本文件副本 config/application.yml 后执行：
#   ./deploy.sh restart
# 只重启容器，不会重新打包。

spring:
  datasource:
    # 不要开启 AUTO_SERVER，服务器主机名无法解析时 H2 会启动失败。
    url: jdbc:h2:file:./data/newsdb;DB_CLOSE_ON_EXIT=FALSE

crawler:
  fixed-delay: 300000
  timeout: 10000

article:
  expire:
    days: 10

sync:
  api:
    base-url: http://127.0.0.1:18082
